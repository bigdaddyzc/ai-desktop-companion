{
  "name": "xinban-desktop-companion",
  "version": "0.3.0",
  "private": true,
  "description": "ESP32 desktop robot with a cloud-assisted intelligent host and desktop simulator",
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs",
    "build": "npm run typecheck && vite build && node scripts/build-desktop.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:desktop": "playwright test",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "eval": "node scripts/eval/eval.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "firmware:setup": "node scripts/firmware.mjs setup",
    "firmware:build": "node scripts/firmware.mjs build",
    "firmware:test": "node scripts/firmware.mjs test",
    "firmware:flash": "node scripts/firmware.mjs flash",
    "firmware:probe": "node scripts/firmware.mjs probe"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "serialport": "13.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "build": {
    "appId": "com.xinban.desktop-companion",
    "productName": "Xinban",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "asarUnpack": [
      "dist/desktop/xinban-hook.cjs",
      "node_modules/@serialport/bindings-cpp/**"
    ],
    "npmRebuild": false,
    "publish": null,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "芯伴",
      "artifactName": "Xinban-Setup-${version}.exe"
    }
  }
}
